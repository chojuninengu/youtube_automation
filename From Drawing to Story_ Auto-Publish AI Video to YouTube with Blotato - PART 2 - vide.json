      "webhookId": "87f99887-37fa-432a-ba5b-fd8043373e64"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\nreturn body.chunks.map(chunk => ({\n  json: {\n    title: body.title,\n    chunk_number: chunk.chunk_number,\n    script: chunk.script,\n    image_prompt: chunk.image_prompt,\n    duration_seconds: chunk.duration_seconds,\n    characters_used: chunk.characters_used,\n    character_images: chunk.character_images\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -944,
