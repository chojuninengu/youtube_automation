      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body;\n\nreturn body.characters.map(c => ({\n  json: {\n    character_index: c.character_index,\n    image_url: c.image_url\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
