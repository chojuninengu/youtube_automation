    {
      "parameters": {
        "jsCode": "const cloudinary = $input.all();\nconst body = $('Webhook').first().json.body;\n\nconst chunks = body.chunks.map((chunk, i) => ({\n  chunk_number: chunk.chunk_number,\n  script: chunk.script,\n  image_prompt: chunk.image_prompt,\n  duration_seconds: chunk.duration_seconds,\n  scene_image_url: cloudinary[i].json.secure_url\n}));\n\nreturn [{\n  json: {\n    title: body.title,\n    chunks: chunks\n  }\n}];"
